struct SearchableDropdownField<Item: Identifiable>: View {

    @FocusState private var isSearchFocused: Bool

    let title: String
    let items: [Item]
    let selectedText: String
    let defaultValue: String?
    let displayName: (Item) -> String
    let onSelect: (Item) -> Void
    let onSelectAll: (() -> Void)?
    let icon: String
    let type: ActiveDropdown
    let isSearchable: Bool
    let showAllOption: Bool
    let onSearchTextChange: ((String) -> Void)?

    @Binding var activeDropdown: ActiveDropdown

    @State private var searchText: String
    @State private var isSelectingItem = false

    var style = DropDownFieldStyle()
    var placeholder: String?

    private var isExpanded: Bool {
        activeDropdown == type
    }

    private var filteredItems: [Item] {
        items
    }

    private var hasDefaultOption: Bool {
        onSelectAll != nil && defaultValue != nil
    }

    private var isSearchEmpty: Bool {
        searchText
            .trimmingCharacters(in: .whitespacesAndNewlines)
            .isEmpty
    }

    private var shouldShowDefaultOption: Bool {
        hasDefaultOption &&
        (!isSearchable || isSearchEmpty)
    }

    private var visibleRowCount: Int {
        let count = filteredItems.count
        let hasAllOption = shouldShowDefaultOption

        return min(
            count + (hasAllOption ? 1 : 0),
            style.dropdownMaxVisibleRows
        )
    }

    private var calculatedDropdownHeight: CGFloat {
        if filteredItems.isEmpty {
            return 50
        }

        return CGFloat(visibleRowCount) * style.dropdownRowHeight
    }

    init(
        title: String,
        items: [Item],
        selectedText: String,
        defaultValue: String? = nil,
        displayName: @escaping (Item) -> String,
        onSelect: @escaping (Item) -> Void,
        onSelectAll: (() -> Void)? = nil,
        icon: String,
        type: ActiveDropdown,
        activeDropdown: Binding<ActiveDropdown>,
        isSearchable: Bool = true,
        showAllOption: Bool = false,
        onSearchTextChange: ((String) -> Void)? = nil,
        style: DropDownFieldStyle = DropDownFieldStyle(),
        placeholder: String? = nil
    ) {
        self.title = title
        self.items = items
        self.selectedText = selectedText
        self.defaultValue = defaultValue
        self.displayName = displayName
        self.onSelect = onSelect
        self.onSelectAll = onSelectAll
        self.icon = icon
        self.type = type
        self._activeDropdown = activeDropdown
        self.isSearchable = isSearchable
        self.showAllOption = showAllOption
        self.onSearchTextChange = onSearchTextChange
        self.style = style
        self.placeholder = placeholder

        _searchText = State(
            initialValue: selectedText.isEmpty
                ? (defaultValue ?? "")
                : selectedText
        )
    }

    var body: some View {

        VStack(alignment: .leading, spacing: 8) {

            Text(title)
                .font(style.titleFont)
                .tracking(style.tracking)
                .foregroundColor(style.titleColor)

            HStack(spacing: 10) {

                Image(systemName: icon)
                    .font(.system(size: style.iconSize))
                    .foregroundColor(style.textColor)

                if isSearchable {
                    ZStack(alignment: .leading) {

                        if let placeholder,
                           searchText.isEmpty {
                            Text(placeholder)
                                .font(style.inputFont)
                                .foregroundColor(style.placeholderColor)
                                .allowsHitTesting(false)
                        }

                        TextField("", text: $searchText)
                            .font(style.inputFont)
                            .foregroundColor(style.textColor)
                            .tint(style.textColor)
                            .textFieldStyle(.plain)
                            .focused($isSearchFocused)
                    }
                } else {

                    Text(
                        selectedText.isEmpty
                            ? (defaultValue ?? "")
                            : selectedText
                    )
                    .font(style.inputFont)
                    .foregroundColor(style.textColor)
                    .lineLimit(1)

                    Spacer()
                }

                if self.isSearchable {
                    
                    if !selectedText.isEmpty && !searchText.isEmpty && isSearchFocused {
                        Button {
                            searchText = ""
                            onSearchTextChange?("")
                        } label: {
                            Image(systemName: "xmark.circle.fill")
                                .font(.system(size: 16))
                                .foregroundColor(style.textColor)
                        }
                        .buttonStyle(.plain)
                    }
                }

                Button {

                    activeDropdown = isExpanded ? .none : type

                } label: {

                    Image(
                        systemName: isExpanded
                            ? "chevron.up"
                            : "chevron.down"
                    )
                    .font(.system(size: 10, weight: .bold))
                    .foregroundColor(style.textColor)
                }
            }
            .padding(.horizontal, style.horizontalPadding)
            .frame(height: style.fieldHeight)
            .background(style.fillColor)
            .clipShape(
                RoundedRectangle(
                    cornerRadius: style.cornerRadius,
                    style: .continuous
                )
            )
            .overlay {

                RoundedRectangle(
                    cornerRadius: style.cornerRadius,
                    style: .continuous
                )
                .stroke(
                    isExpanded
                        ? style.focusedBorderColor
                        : style.borderColor,
                    lineWidth: 1
                )
            }
            .contentShape(Rectangle())
            .simultaneousGesture(
                TapGesture().onEnded {

                    if isSearchable {
                        isSearchFocused = true
                    }

                    activeDropdown = type
                }
            )
            .overlay(alignment: .topLeading) {

                if isExpanded {

                    dropdownContent
                        .offset(y: style.fieldHeight + 6)
                        .zIndex(1000)
                        .transition(
                            .opacity
                                .combined(with: .offset(y: -8))
                        )
                }
            }
            .zIndex(isExpanded ? 1000 : 0)
            .onChange(of: selectedText) { newValue in

                searchText = newValue.isEmpty
                    ? (defaultValue ?? "")
                    : newValue

                isSearchFocused = false
            }
            .onChange(of: activeDropdown) { newValue in
                if newValue != type {

                    if !isSelectingItem {
                        searchText = selectedText.isEmpty
                            ? (defaultValue ?? "")
                            : selectedText
                    }

                    isSelectingItem = false
                    isSearchFocused = false
                }
            }
            .onChange(of: searchText) { newValue in

                guard isSearchable, isSearchFocused else {
                    return
                }

                onSearchTextChange?(newValue)
            }
        }
        .zIndex(isExpanded ? 1000 : 0)
    }

    @ViewBuilder
    private var dropdownContent: some View {

        VStack(spacing: 0) {

            if filteredItems.isEmpty {

                Text("No results found")
                    .font(style.titleFont)
                    .foregroundColor(style.titleColor)
                    .frame(maxWidth: .infinity)
                    .frame(height: 50)

            } else {

                // Show default / Select All only when:
                // 1. onSelectAll exists
                // 2. defaultValue exists
                // 3. Dropdown is non-searchable OR search is empty
                if let onSelectAll,
                   let defaultValue,
                   shouldShowDefaultOption {

                    Button {
                        isSelectingItem = true

                        onSelectAll()

                        searchText = defaultValue
                        isSearchFocused = false

                        activeDropdown = .none
                    } label: {

                        dropdownRow(
                            title: defaultValue,
                            isSelected: selectedText == defaultValue
                        )
                    }
                    .buttonStyle(.plain)

                    Divider()
                        .background(style.borderColor)
                }

                ScrollView {

                    LazyVStack(spacing: 0) {

                        ForEach(filteredItems) { item in

                            Button {
                                let value = displayName(item)

                                isSelectingItem = true
                                onSelect(item)
                                searchText = value
                                isSearchFocused = false

                                activeDropdown = .none

                            } label: {
                                dropdownRow(
                                    title: displayName(item),
                                    isSelected: selectedText == displayName(item)
                                )
                            }
                            .buttonStyle(.plain)
                        }
                    }
                }
                .scrollIndicators(.hidden)
            }
        }
        .frame(maxWidth: .infinity)
        .frame(height: calculatedDropdownHeight)
        .background(style.fillColor)
        .clipShape(
            RoundedRectangle(
                cornerRadius: style.cornerRadius,
                style: .continuous
            )
        )
        .overlay {

            RoundedRectangle(
                cornerRadius: style.cornerRadius,
                style: .continuous
            )
            .stroke(style.borderColor, lineWidth: 1)
        }
        .shadow(
            color: .black.opacity(0.35),
            radius: 10,
            x: 0,
            y: 5
        )
    }

    private func dropdownRow(
        title: String,
        isSelected: Bool
    ) -> some View {

        HStack {

            Text(title)
                .font(style.inputFont)
                .foregroundColor(style.textColor)
                .lineLimit(1)

            Spacer()

            if isSelected {

                Image(systemName: "checkmark")
                    .font(.system(size: 11, weight: .semibold))
                    .foregroundColor(style.textColor)
            }
        }
        .padding(.horizontal, style.horizontalPadding)
        .frame(height: style.dropdownRowHeight)
        .contentShape(Rectangle())
    }
}

enum ActiveDropdown {
    case none
  // You can add your different dropdown's enum here
}
